{
  "name": "graph-api",
  "version": "1.0.0",
  "description": "GraphQL Yoga aggregation and orchestration layer",
  "type": "module",
  "main": "dist/src/bootstrap.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/bootstrap.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "prepare": "husky",
    "start": "node dist/src/bootstrap.js",
    "test": "vitest run --exclude 'tests/stack/**'",
    "test:watch": "vitest tests",
    "typecheck": "tsc --noEmit",
    "test:integration": "vitest run tests/stack",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:check": "graphql-codegen --config codegen.ts --check",
    "infra:synth": "TSX_TSCONFIG_PATH=infra/tsconfig.json node --import ../graph-rest-react-stack/platform-cdk/node_modules/tsx/dist/loader.mjs infra/app.ts",
    "infra:typecheck": "../graph-rest-react-stack/platform-cdk/node_modules/.bin/tsc --project infra/tsconfig.json",
    "infra:test": "../graph-rest-react-stack/platform-cdk/node_modules/.bin/vitest run --config infra/vitest.config.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.15.0",
  "devDependencies": {
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.33.0",
    "@graphql-codegen/cli": "^7.4.3",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-resolvers": "^6.1.0",
    "@types/node": "^24.3.0",
    "@types/supertest": "^7.2.1",
    "commitlint": "^19.8.1",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "jiti": "^2.4.2",
    "lint-staged": "^16.1.5",
    "prettier": "^3.6.2",
    "supertest": "^7.3.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.40.0",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.61.0",
    "@aws-sdk/client-dynamodb": "^3.868.0",
    "@aws-sdk/lib-dynamodb": "^3.868.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "0.203.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.203.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.203.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.203.0",
    "@opentelemetry/sdk-logs": "0.203.0",
    "@opentelemetry/sdk-metrics": "2.0.1",
    "@opentelemetry/sdk-node": "^0.203.0",
    "aws-jwt-verify": "^5.1.0",
    "dataloader": "^2.2.3",
    "dotenv": "^17.2.2",
    "graphql": "^16.11.0",
    "graphql-yoga": "^5.15.1",
    "openai": "^5.20.0",
    "zod": "^3.25.76"
  }
}
