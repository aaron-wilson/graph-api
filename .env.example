# GraphQL HTTP port; default 4000.
PORT=4000
# Minimum structured log level; default info.
LOG_LEVEL=info
# Browser origin allowed by CORS; default http://localhost:3001.
CORS_ORIGIN=http://localhost:3001
# Independent provider selectors; all default to offline mocks.
PROVIDER_WEATHER=mock
PROVIDER_PLACES=mock
PROVIDER_EVENTS=mock
PROVIDER_LLM=mock
# Vendor endpoints; defaults shown. Override for local transport tests only.
WTTR_URL=https://wttr.in
OVERPASS_URL=https://overpass-api.de/api/interpreter
TICKETMASTER_URL=https://app.ticketmaster.com/discovery/v2/events.json
# Secret; required only for Ticketmaster selection.
TICKETMASTER_API_KEY=
# Secrets/models required only for the selected LLM.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_BASE_URL=
# Bounded vendor request timeout, also the LLM first-token and between-chunk timeout; default 5000 ms.
PROVIDER_TIMEOUT_MS=5000
# Total LLM stream deadline; default 60000 ms, 1000–300000.
PROVIDER_STREAM_DEADLINE_MS=60000
# Trip REST service origin (not public); default http://127.0.0.1:3000.
REST_URL=http://127.0.0.1:3000
# Per-request REST timeout; default 3000 ms. Requests are never retried.
REST_TIMEOUT_MS=3000
# demo accepts only "Bearer demo"; live verifies Cognito access tokens. Default demo.
APP_MODE=demo
# Cognito identifiers (not secret); required only when APP_MODE=live.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Maximum selection depth per operation; default 8.
MAX_QUERY_DEPTH=8
# Maximum field cost, with list children multiplied by the requested page size; default 500.
MAX_QUERY_COMPLEXITY=500
# true enables introspection and GraphiQL; default false.
ALLOW_INTROSPECTION=false
# off (default) sends nothing; otlp exports traces, metrics, and redacted logs.
TELEMETRY_MODE=off
# OTLP HTTP collector origin; required only when TELEMETRY_MODE=otlp.
OTEL_EXPORTER_OTLP_ENDPOINT=
