# GraphQL HTTP port; default 4000.
PORT=4000
# Minimum structured log level; default info.
LOG_LEVEL=info
# Browser origin allowed by CORS; default http://localhost:3001.
CORS_ORIGIN=http://localhost:3001
# Independent provider selectors; all default to offline mocks.
PROVIDER_WEATHER=mock
PROVIDER_PLACES=mock
PROVIDER_EVENTS=mock
PROVIDER_LLM=mock
# Vendor endpoints; defaults shown. Override for local transport tests only.
WTTR_URL=https://wttr.in
OVERPASS_URL=https://overpass-api.de/api/interpreter
TICKETMASTER_URL=https://app.ticketmaster.com/discovery/v2/events.json
# Secret; required only for Ticketmaster selection.
TICKETMASTER_API_KEY=
# Secrets/models required only for the selected LLM.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_BASE_URL=
# Bounded vendor request timeout; default 5000 ms.
PROVIDER_TIMEOUT_MS=5000
