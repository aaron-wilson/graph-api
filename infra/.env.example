# Deployment only; explicit process inputs, never automatically read.
# Required target account (public identifier), region, environment and exactly two AZs.
PLATFORM_ACCOUNT=111111111111
PLATFORM_REGION=us-east-1
PLATFORM_ENV=demo
PLATFORM_AVAILABILITY_ZONES=us-east-1a,us-east-1b
# Required HTTPS browser origin; must match foundation Cognito callback origin.
PLATFORM_SITE_ORIGIN=https://wander.example
# Required immutable image tag: full service Git SHA, never latest.
API_IMAGE_TAG=1111111111111111111111111111111111111111
# Graph only: optional provider selections; secrets referenced by name, never supplied here.
API_LLM_PROVIDER=mock
API_LLM_MODEL=
API_EVENTS_PROVIDER=mock
